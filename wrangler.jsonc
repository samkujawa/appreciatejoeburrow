// Cloudflare Workers config. The site is fully static: Workers serves the Vite build from dist/,
// including the security headers in dist/_headers (copied from public/_headers). Unknown URLs get
// dist/404.html with a 404 status.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "appreciatejoeburrow",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
